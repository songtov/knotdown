{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "declaration": true,
    "declarationMap": true,
    "noEmit": false,
    "outDir": "./dist",
    "rewriteRelativeImportExtensions": true,
    "rootDir": ".",
    "sourceMap": true
  },
  "include": ["packages/**/*.ts"],
  "exclude": ["tests/**"]
}
